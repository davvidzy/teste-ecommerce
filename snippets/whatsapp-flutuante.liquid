{%- comment -%}
  ============================================================
  whatsapp-flutuante — botão fixo de atendimento (canto inferior direito)
  ============================================================

  O QUE FAZ:
  Abre uma conversa no WhatsApp (wa.me) com uma mensagem pronta.
  Na página de produto, a mensagem já cita a peça que o cliente está
  vendo, então o atendimento não precisa perguntar "qual produto?".

  CONFIGURAÇÃO:
  Configurações do tema › WhatsApp: número (só dígitos, com DDI 55
  e DDD), mensagem padrão e onde mostrar. Sem número = não aparece.

  DETALHES:
  - Entra com um pequeno atraso para não competir com o hero.
  - Não aparece no carrinho (lá a ação principal é finalizar a compra).
  - Respeita a área segura do iPhone (env(safe-area-inset-bottom)).
{%- endcomment -%}
{%- liquid
  assign numero = settings.whatsapp_numero | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
  assign mostrar = true
  if numero == blank or request.page_type == 'cart' or request.page_type == 'password'
    assign mostrar = false
  endif
  if settings.whatsapp_so_produto and request.page_type != 'product'
    assign mostrar = false
  endif

  assign mensagem = settings.whatsapp_mensagem
  if request.page_type == 'product'
    assign mensagem = 'general.whatsapp.product_message' | t: produto: product.title
    assign mensagem = mensagem | append: ' ' | append: shop.url | append: product.url
  endif
-%}
{%- if mostrar -%}
  <a
    class="whatsapp-flutuante"
    href="https://wa.me/{{ numero }}?text={{ mensagem | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'general.whatsapp.label' | t }}"
  >
    {% render 'icon', name: 'whatsapp' %}
    <span class="whatsapp-flutuante__texto">{{ 'general.whatsapp.cta' | t }}</span>
  </a>

  <style>
    .whatsapp-flutuante {
      position: fixed;
      right: max(16px, var(--gutter));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: 40;
      display: inline-flex;
      align-items: center;
      gap: 0;
      height: 52px;
      padding: 0 14px;
      border-radius: 999px;
      background: var(--color-accent);
      color: var(--color-accent-text);
      text-decoration: none;
      box-shadow: 0 10px 30px -10px rgb(18 22 20 / 0.45);
      animation: whatsapp-entra 600ms cubic-bezier(0.22, 0.61, 0.36, 1) 1.2s both;
      transition: gap 350ms var(--ease-out), padding 350ms var(--ease-out);
    }
    .whatsapp-flutuante svg { width: 24px; height: 24px; flex: none; }
    /* o texto "Fale conosco" abre no hover (desktop); no celular fica só o ícone */
    .whatsapp-flutuante__texto {
      max-width: 0;
      overflow: hidden;
      white-space: nowrap;
      font-size: 0.875rem;
      font-weight: 500;
      transition: max-width 350ms var(--ease-out);
    }
    @media (hover: hover) {
      .whatsapp-flutuante:hover { gap: 10px; padding: 0 20px 0 16px; }
      .whatsapp-flutuante:hover .whatsapp-flutuante__texto { max-width: 160px; }
    }
    .whatsapp-flutuante:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
    @keyframes whatsapp-entra { from { opacity: 0; transform: translateY(16px) scale(0.9); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .whatsapp-flutuante { animation: none; } }
  </style>
{%- endif -%}
