{%- comment -%}
  ============================================================
  icon — biblioteca de ícones SVG inline
  ============================================================

  O QUE FAZ:
  Renderiza um ícone SVG inline pelo nome, com width/height explícitos
  (bom para acessibilidade e performance). Usa currentColor, então herda
  a cor do texto do elemento pai.

  COMO USAR:
  {% render 'icon', name: 'cart' %}

  PARÂMETROS:
  - name: nome do ícone. Disponíveis:
    search, account, cart, close, chevron, trash,
    instagram, facebook, linkedin,
    entrega, folha, escudo, presente, diamante (selos de confiança),
    seta, seta-cima, mais, check (botões e estados),
    compartilhar, whatsapp, pinterest, x, email, link (compartilhamento).

  OBSERVAÇÕES:
  Nome inexistente não renderiza nada (case sem when correspondente).
  Para adicionar um ícone novo, crie mais um bloco {%- when 'nome' -%}.
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M5 20c0-3.87 3.13-7 7-7s7 3.13 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 6h15l-1.5 9h-12L6 6Zm0 0-.5-3H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.5" fill="currentColor"/><circle cx="17" cy="20" r="1.5" fill="currentColor"/></svg>
  {%- when 'close' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'chevron' -%}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'trash' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M3 5h14M8 5V3h4v2m-6 0 1 12h6l1-12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'instagram' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="7" r="1" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14 8h2V5h-2c-2 0-3 1.5-3 3.5V11H9v3h2v6h3v-6h2l.5-3H14V8.5c0-.3.2-.5.5-.5Z" fill="currentColor"/></svg>
  {%- when 'linkedin' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 10v6M7 7v.01M11 16v-3.5a1.5 1.5 0 0 1 3 0V16m-3-3.5V10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- comment -%} Ícones adicionados para a loja Orvalho (hero, catálogo e rodapé) {%- endcomment -%}
  {%- when 'entrega' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'folha' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14H5Zm0 0 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'escudo' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.5 3 8.5 7 10 4-1.5 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'presente' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7c-1.5-3-5-3-5-1s3 1 5 1Zm0 0c1.5-3 5-3 5-1s-3 1-5 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'diamante' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M7 4h10l4 5-9 11L3 9l4-5Zm-4 5h18M9.5 4 8 9l4 11 4-11-1.5-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'seta' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'seta-cima' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M10 16V4m-5 5 5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'mais' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'compartilhar' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="15" cy="4.5" r="2.25" stroke="currentColor" stroke-width="1.4"/><circle cx="5" cy="10" r="2.25" stroke="currentColor" stroke-width="1.4"/><circle cx="15" cy="15.5" r="2.25" stroke="currentColor" stroke-width="1.4"/><path d="m7 8.9 6-3.3M7 11.1l6 3.3" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'whatsapp' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1L4 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.2 8.6c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.6 1.5c.1.2 0 .4-.1.5l-.4.5c-.1.1-.2.3 0 .5.3.6 1.2 1.6 2.3 2.1.2.1.4.1.5 0l.6-.7c.1-.2.3-.2.5-.1l1.4.7c.2.1.3.2.3.4 0 .6-.4 1.4-1.2 1.6-.7.2-2.1.1-3.8-1.3-1.5-1.3-2.4-2.9-2.6-3.6-.2-.8 0-1.4.2-1.8Z" fill="currentColor"/></svg>
  {%- when 'pinterest' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 20.5 12 13m0 0c.4.9 1.3 1.4 2.3 1.3 2-.2 3.2-2.3 2.9-4.6-.3-2.4-2.6-3.8-5-3.4-2.6.4-4 2.7-3.5 5 .1.6.4 1 .8 1.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'x' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4.5 4h4.2l10.8 16h-4.2L4.5 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M19.5 4l-6.2 7M10.7 13 4.5 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'email' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="m4 6.5 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'link' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="m4.5 10.5 3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
