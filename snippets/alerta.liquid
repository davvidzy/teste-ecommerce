{%- comment -%}
  ============================================================
  alerta — notificação global (toast) lateral
  ============================================================

  O QUE FAZ:
  Toast fixo no canto superior direito (logo abaixo do header),
  em cor SÓLIDA, que entra deslizando pela lateral. Pode ter um
  botão de ação (ex: "Ver sacola") e uma barra de tempo que mostra
  quando ele vai fechar sozinho. Passar o mouse pausa o fechamento.

  COMO USAR:
  {% render 'alerta' %}   (uma vez, em layout/theme.liquid)
  No JS:
    mostrarAlerta('Produto adicionado!', 'positivo')
    mostrarAlerta('Sem estoque', 'negativo', 5000)
    mostrarAlerta('Adicionado à sacola', 'positivo', 5000, { texto: 'Ver sacola', url: '/cart' })

  PARÂMETROS (da função):
  - mensagem: texto.
  - tipo: 'positivo' (cor de destaque) | 'negativo' (vermelho escuro).
  - duracao: ms até fechar (0 = não fecha sozinho). Padrão 4000.
  - acao: { texto, url } opcional → vira um botão-link no toast.

  ACESSIBILIDADE:
  role="status" + aria-live="polite": leitores de tela anunciam a
  mensagem sem roubar o foco. Esc fecha.
{%- endcomment -%}
<div id="alerta" class="alerta" role="status" aria-live="polite" aria-atomic="true">
  <div class="alerta__conteudo">
    <span class="alerta__icone" aria-hidden="true">
      <span class="alerta__icone--positivo">{% render 'icon', name: 'check' %}</span>
      <span class="alerta__icone--negativo">!</span>
    </span>
    <p class="alerta__mensagem" data-alerta-mensagem></p>
    <a href="#" class="alerta__acao" data-alerta-acao hidden></a>
    <button type="button" class="alerta__fechar" aria-label="{{ 'accessibility.close' | t }}" data-alerta-fechar>
      {% render 'icon', name: 'close' %}
    </button>
    <span class="alerta__tempo" aria-hidden="true"></span>
  </div>
</div>

<style>
  .alerta {
    --alerta-fundo: var(--color-accent);
    --alerta-texto: var(--color-accent-text);
    position: fixed;
    top: calc(var(--header-altura, 72px) + 12px);
    right: var(--gutter, 20px);
    z-index: 10001;
    width: min(400px, calc(100vw - 2 * var(--gutter, 20px)));
    visibility: hidden;
    opacity: 0;
    transform: translate3d(calc(100% + var(--gutter, 20px)), 0, 0);
    /* SAÍDA: rápida e discreta */
    transition:
      transform 380ms cubic-bezier(0.4, 0, 1, 1),
      opacity 300ms ease,
      visibility 0s linear 380ms;
  }
  .alerta.negativo { --alerta-fundo: #8a3a32; --alerta-texto: #fbf6f2; }
  /*
    ENTRADA: desliza da direita com "ease-out cúbico" (0.22, 0.61, 0.36, 1).
    A curva anterior (--ease-out = 0.22, 1, 0.36, 1) fazia ~60% do trajeto
    nos primeiros 100ms — medimos quadro a quadro na loja — e parecia um
    "tranco". Esta distribui o movimento: ~35% em 100ms, assentando suave.
  */
  .alerta.visivel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 450ms ease;
  }

  /* O conteúdo entra em sequência, depois do cartão: ícone → texto → "Ver sacola" */
  .alerta__icone,
  .alerta__mensagem,
  .alerta__acao {
    opacity: 0;
    transform: translate3d(14px, 0, 0);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .alerta.visivel .alerta__icone,
  .alerta.visivel .alerta__mensagem,
  .alerta.visivel .alerta__acao {
    opacity: 1;
    transform: none;
    transition: opacity 450ms ease, transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .alerta.visivel .alerta__icone { transition-delay: 160ms; }
  .alerta.visivel .alerta__mensagem { transition-delay: 220ms; }
  .alerta.visivel .alerta__acao { transition-delay: 300ms; }

  .alerta__conteudo {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 6px 14px;
    padding: 16px 14px 16px 18px;
    overflow: hidden;
    color: var(--alerta-texto);
    background: var(--alerta-fundo);
    border-radius: 4px;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
  }
  .alerta__icone {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    font-weight: 500;
  }
  .alerta__icone svg { width: 16px; height: 16px; }
  .alerta__icone--negativo, .alerta.negativo .alerta__icone--positivo { display: none; }
  .alerta.negativo .alerta__icone--negativo { display: inline; }
  .alerta__mensagem { font-size: 0.9375rem; line-height: 1.35; }

  /* Ação ("Ver sacola") — ocupa a linha de baixo, alinhada ao texto */
  .alerta__acao {
    grid-column: 2 / 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 16px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--alerta-fundo);
    background: var(--alerta-texto);
    border-radius: var(--buttons-radius, 40px);
  }
  .alerta.visivel .alerta__acao:hover { transform: translateY(-1px); transition-delay: 0ms; }
  .alerta__acao[hidden] { display: none; }

  .alerta__fechar {
    grid-row: 1;
    grid-column: 3;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: inherit;
    background: none;
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity var(--dur-fast), background-color var(--dur-fast);
  }
  .alerta__fechar:hover { opacity: 1; background: color-mix(in srgb, currentColor 14%, transparent); }
  .alerta__fechar svg { width: 18px; height: 18px; }

  /* Barra de tempo restante (encolhe da esquerda para a direita) */
  .alerta__tempo {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: color-mix(in srgb, currentColor 45%, transparent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .alerta.contando .alerta__tempo { animation: alerta-tempo var(--alerta-duracao, 4000ms) linear forwards; }
  .alerta.contando:hover .alerta__tempo { animation-play-state: paused; }
  @keyframes alerta-tempo { from { transform: scaleX(1); } to { transform: scaleX(0); } }
</style>

<script>
  (function () {
    var alerta = document.getElementById('alerta');
    var mensagemEl = alerta.querySelector('[data-alerta-mensagem]');
    var acaoEl = alerta.querySelector('[data-alerta-acao]');
    var timer = null;
    var restante = 0;
    var inicio = 0;

    function iniciarContagem(ms) {
      clearTimeout(timer);
      inicio = Date.now();
      restante = ms;
      timer = setTimeout(fecharAlerta, ms);
    }

    function mostrarAlerta(mensagem, tipo, duracao, acao) {
      tipo = tipo || 'positivo';
      duracao = duracao === undefined ? 4000 : duracao;

      mensagemEl.textContent = mensagem;
      alerta.classList.remove('positivo', 'negativo', 'contando');
      alerta.classList.add(tipo);

      if (acao && acao.texto && acao.url) {
        acaoEl.textContent = acao.texto;
        acaoEl.href = acao.url;
        acaoEl.hidden = false;
      } else {
        acaoEl.hidden = true;
      }

      alerta.style.setProperty('--alerta-duracao', duracao + 'ms');
      void alerta.offsetWidth; // reinicia a animação da barra de tempo
      alerta.classList.add('visivel');

      clearTimeout(timer);
      if (duracao > 0) {
        alerta.classList.add('contando');
        iniciarContagem(duracao);
      }
    }

    function fecharAlerta() {
      clearTimeout(timer);
      alerta.classList.remove('visivel', 'contando');
    }

    // Mouse em cima pausa o fechamento; ao sair, continua de onde parou.
    alerta.addEventListener('mouseenter', function () {
      if (!alerta.classList.contains('contando')) return;
      clearTimeout(timer);
      restante -= Date.now() - inicio;
    });
    alerta.addEventListener('mouseleave', function () {
      if (alerta.classList.contains('contando')) iniciarContagem(Math.max(restante, 800));
    });

    alerta.querySelector('[data-alerta-fechar]').addEventListener('click', fecharAlerta);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && alerta.classList.contains('visivel')) fecharAlerta();
    });

    window.mostrarAlerta = mostrarAlerta;
    window.fecharAlerta = fecharAlerta;
  })();
</script>
