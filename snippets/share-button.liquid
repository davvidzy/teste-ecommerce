{%- comment -%}
  ============================================================
  share-button — compartilhar (redes sociais + copiar link)
  ============================================================

  O QUE FAZ:
  Botão TERCIÁRIO "Compartilhar" que abre um pequeno painel com:
  WhatsApp, Facebook, Pinterest, X, e-mail e "Copiar link".

  COMO USAR:
  {% render 'share-button',
    share_link: product.url,
    share_title: product.title,
    share_image: product.featured_image
  %}

  PARÂMETROS:
  - share_link:  caminho a compartilhar (somado a shop.url).
  - share_title: título (vai no texto do WhatsApp/X/e-mail).
  - share_image: imagem (opcional — o Pinterest precisa de uma).

  COMO FUNCIONA:
  - É um <details>/<summary>: abre e fecha SEM JavaScript.
  - Cada rede é só um link com a URL de compartilhamento dela
    (montada no Liquid com o filtro url_encode). Nada de SDK,
    nada de script de terceiros rastreando o visitante.
  - O JS (custom element <compartilhar-produto>) só faz duas coisas:
    copiar o link (Clipboard API) e fechar o painel ao clicar fora/Esc.
{%- endcomment -%}
{%- liquid
  assign url_compartilhar = shop.url | append: share_link
  assign url_cod = url_compartilhar | url_encode
  assign titulo_cod = share_title | url_encode
  assign texto_whatsapp = share_title | append: ' ' | append: url_compartilhar | url_encode
  assign imagem_cod = ''
  if share_image
    assign imagem_cod = share_image | image_url: width: 1200 | prepend: 'https:' | url_encode
  endif
-%}
<compartilhar-produto class="compartilhar">
  <details class="compartilhar__details">
    <summary class="button button--tertiary compartilhar__gatilho">
      {% render 'icon', name: 'compartilhar' %}
      {{ 'products.product.share' | t }}
    </summary>

    <div class="compartilhar__painel">
      <ul class="compartilhar__redes" role="list">
        <li>
          <a href="https://wa.me/?text={{ texto_whatsapp }}" target="_blank" rel="noopener" class="compartilhar__rede">
            {% render 'icon', name: 'whatsapp' %}<span>WhatsApp</span>
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ url_cod }}" target="_blank" rel="noopener" class="compartilhar__rede">
            {% render 'icon', name: 'facebook' %}<span>Facebook</span>
          </a>
        </li>
        <li>
          <a href="https://pinterest.com/pin/create/button/?url={{ url_cod }}&media={{ imagem_cod }}&description={{ titulo_cod }}" target="_blank" rel="noopener" class="compartilhar__rede">
            {% render 'icon', name: 'pinterest' %}<span>Pinterest</span>
          </a>
        </li>
        <li>
          <a href="https://twitter.com/intent/tweet?text={{ titulo_cod }}&url={{ url_cod }}" target="_blank" rel="noopener" class="compartilhar__rede">
            {% render 'icon', name: 'x' %}<span>X</span>
          </a>
        </li>
        <li>
          <a href="mailto:?subject={{ titulo_cod }}&body={{ url_cod }}" class="compartilhar__rede">
            {% render 'icon', name: 'email' %}<span>{{ 'sections.compartilhar.email' | t }}</span>
          </a>
        </li>
      </ul>

      <button type="button" class="compartilhar__copiar" data-copiar-link data-url="{{ url_compartilhar }}">
        {% render 'icon', name: 'link' %}
        <span data-copiar-rotulo>{{ 'sections.compartilhar.copy_link' | t }}</span>
      </button>
      <span class="visually-hidden" role="status" aria-live="polite" data-copiar-status></span>
    </div>
  </details>
</compartilhar-produto>

<style>
  .compartilhar { position: relative; display: inline-block; }
  .compartilhar__gatilho { list-style: none; gap: 8px; }
  .compartilhar__gatilho::-webkit-details-marker { display: none; }
  .compartilhar__gatilho svg { width: 16px; height: 16px; }
  .compartilhar__gatilho:hover svg { transform: none; }

  .compartilhar__painel {
    position: absolute;
    left: 0;
    bottom: calc(100% + 8px);
    z-index: 10;
    width: 260px;
    padding: 8px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.3);
    animation: compartilhar-abre 350ms var(--ease-out);
  }
  .compartilhar__redes { display: grid; grid-template-columns: 1fr 1fr; list-style: none; }
  .compartilhar__rede,
  .compartilhar__copiar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 10px;
    font-size: 0.875rem;
    color: inherit;
    background: none;
    transition: background-color var(--dur-fast);
  }
  .compartilhar__rede:hover,
  .compartilhar__copiar:hover { background: color-mix(in srgb, var(--color-text) 6%, transparent); }
  .compartilhar__rede svg, .compartilhar__copiar svg { width: 18px; height: 18px; flex-shrink: 0; }
  .compartilhar__copiar { width: 100%; margin-top: 4px; border-top: 1px solid var(--color-border); font-family: var(--font-body-family); }
  .compartilhar__copiar.is-copiado { color: var(--color-accent); }

  @keyframes compartilhar-abre { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>

<script>
  if (!customElements.get('compartilhar-produto')) {
    customElements.define('compartilhar-produto', class extends HTMLElement {
      connectedCallback() {
        this.details = this.querySelector('details');
        this.botao = this.querySelector('[data-copiar-link]');
        this.rotulo = this.querySelector('[data-copiar-rotulo]');
        this.status = this.querySelector('[data-copiar-status]');
        this.textoOriginal = this.rotulo.textContent;

        this.botao.addEventListener('click', () => this.copiar());

        this.aoClicarFora = (e) => { if (this.details.open && !this.contains(e.target)) this.details.open = false; };
        this.aoTeclar = (e) => { if (e.key === 'Escape' && this.details.open) { this.details.open = false; this.querySelector('summary').focus(); } };
        document.addEventListener('click', this.aoClicarFora);
        document.addEventListener('keydown', this.aoTeclar);
      }

      disconnectedCallback() {
        document.removeEventListener('click', this.aoClicarFora);
        document.removeEventListener('keydown', this.aoTeclar);
      }

      async copiar() {
        var url = this.botao.dataset.url;
        try {
          await navigator.clipboard.writeText(url);
        } catch (e) {
          // Fallback para navegadores sem Clipboard API (ou fora de https)
          var campo = document.createElement('textarea');
          campo.value = url;
          document.body.appendChild(campo);
          campo.select();
          document.execCommand('copy');
          campo.remove();
        }
        var copiado = {{ 'sections.compartilhar.copied' | t | json }};
        this.botao.classList.add('is-copiado');
        this.rotulo.textContent = copiado;
        this.status.textContent = copiado;
        clearTimeout(this.timer);
        this.timer = setTimeout(() => {
          this.botao.classList.remove('is-copiado');
          this.rotulo.textContent = this.textoOriginal;
        }, 2000);
      }
    });
  }
</script>
