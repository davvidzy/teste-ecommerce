        },
        "d2": {
          "type": "item",
          "settings": {
            "icone": "folha",
            "titulo": "Ouro 18k reciclado",
            "texto": "<p>Refinado a partir de joias e eletrônicos antigos. Nada de mina nova.</p>"
          }
        },
        "d3": {
          "type": "item",
          "settings": {
            "icone": "escudo",
            "titulo": "Garantia vitalícia",
            "texto": "<p>Certificado de autenticidade e reparo grátis contra defeitos.</p>"
          }
        },
