{%- comment -%}
  ============================================================
  NAV / HEADER — cabeçalho fixo do site
  ============================================================

  O QUE FAZ:
  Cabeçalho que fica FIXO no topo ao rolar (position: sticky no
  wrapper da section). Tem logo, menu de até 3 níveis, botão de
  busca (abre o popup de busca preditiva), conta e sacola.
  No celular, um botão hambúrguer abre o menu por cima da página.

  ONDE É USADA:
  sections/header-group.json (depois da barra de anúncio).

  COMO O "FIXO" FUNCIONA:
  - O Shopify envolve cada section num <div class="shopify-section
    section-header">. O sticky é aplicado NESSE wrapper (se fosse no
    <header> de dentro, ele só grudaria dentro do próprio wrapper).
  - Ao rolar mais de 8px, o JS adiciona .is-rolado (sombra + borda).
    A altura NÃO muda ao rolar, para não empurrar o conteúdo.

  ALTURAS EXPOSTAS EM CSS (medidas pelo JS, atualizadas no resize):
  --header-altura → altura do header (usada no sticky da página de produto)
  --topo-altura   → barra de anúncio + header (o hero usa
                    calc(100svh - var(--topo-altura)) para ocupar
                    exatamente o resto da primeira tela)

  PRINCIPAIS PARTES:
  - Logo: imagem (settings.logo) ou o snippet 'logo' (SVG + nome).
  - [data-carrinho-alvo]: o ícone da sacola é o "alvo" da animação
    do "+" voando ao adicionar produto (assets/carrinho.js).
  - [data-abrir-busca]: link para /search que o assets/busca.js
    intercepta para abrir o popup (sem JS, vai para a página de busca).
{%- endcomment -%}
<header class="header page-width" data-section-id="{{ section.id }}" data-header>
  <div class="header__inner">
    <button
      type="button"
      class="header__menu-toggle tap-target"
      aria-label="{{ 'sections.header.menu' | t }}"
      aria-expanded="false"
      aria-controls="MobileNav-{{ section.id }}"
    >
      <span class="header__burger"></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo-link" aria-label="{{ section.settings.nome_logo | default: shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        {% render 'logo', nome: section.settings.nome_logo %}
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title | escape }}
            </a>
            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}">
                    <a href="{{ child.url }}" class="header__submenu-link">{{ child.title | escape }}</a>
                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__action-button tap-target" data-abrir-busca aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__conta tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__action-button header__cart tap-target" aria-label="{{ 'templates.cart.cart' | t }}" data-carrinho-alvo>
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
    <div class="header__localization">
      {% render 'localization-form',
        section_id: section.id,
        show_country: section.settings.enable_country_selector,
        show_language: section.settings.enable_language_selector
      %}
    </div>
  {%- endif -%}
</header>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" hidden>
  <ul class="header__mobile-menu page-width" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        <a href="{{ link.url }}" class="header__mobile-link">{{ link.title | escape }}</a>
        {%- if link.links != blank -%}
          <ul role="list" class="header__mobile-submenu">
            {%- for child in link.links -%}
              <li><a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child">{{ child.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% render 'busca-modal', termos_populares: section.settings.termos_populares %}

<style>
  /* ---------- Fixo no topo ---------- */
  .section-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-background);
    transition: box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .section-header.is-rolado {
    border-bottom-color: var(--color-border);
    box-shadow: 0 6px 24px -12px rgb(0 0 0 / 0.12);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }

  /* ---------- Logo ---------- */
  .header__logo-link { display: inline-flex; color: var(--color-text); }
  .header__logo-image { display: block; height: auto; }
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo__simbolo { width: 20px; height: auto; color: var(--color-accent); }
  .logo__nome {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    line-height: 1;
    margin-right: -0.3em; /* o letter-spacing também é aplicado depois da última letra: compensa */
  }

  /* ---------- Menu ---------- */
  .header__nav { justify-self: center; }
  .header__menu { display: flex; align-items: center; gap: 32px; list-style: none; }
  .header__menu-item { position: relative; }
  .header__menu-link,
  .header__submenu-link {
    display: inline-block;
    padding: 8px 0;
    font-family: var(--font-body-family);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 calc(100% - 4px);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size var(--dur-base) var(--ease-out);
  }
  .header__menu-link:hover,
  .header__menu-link[aria-current='page'] { background-size: 100% 1px; }
  .header__submenu {
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 220px;
    padding: 12px 0;
    list-style: none;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px -20px rgb(0 0 0 / 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--dur-fast) ease, transform var(--dur-base) var(--ease-out), visibility var(--dur-fast);
    z-index: 20;
  }
  .header__submenu--nested { top: -12px; left: 100%; }
  .header__menu-item--has-dropdown:hover > .header__submenu,
  .header__menu-item--has-dropdown:focus-within > .header__submenu,
  .header__submenu-item--has-dropdown:hover > .header__submenu,
  .header__submenu-item--has-dropdown:focus-within > .header__submenu { opacity: 1; visibility: visible; transform: none; }
  .header__submenu-item { position: relative; }
  .header__submenu-link { display: block; padding: 8px 20px; background-image: none; text-transform: none; letter-spacing: 0.02em; font-weight: 400; font-size: 0.9375rem; }
  .header__submenu-link:hover { color: var(--color-accent); }

  /* ---------- Ações ---------- */
  .header__actions { display: flex; align-items: center; gap: 2px; justify-self: end; }
  .header__action-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    background: none;
    border-radius: 50%;
    transition: background-color var(--dur-fast) ease;
  }
  .header__action-button:hover { background-color: color-mix(in srgb, var(--color-text) 7%, transparent); }
  .header__action-button svg { width: 21px; height: 21px; }
  .header__cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 500;
    line-height: 17px;
    text-align: center;
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-radius: 9px;
  }

  /* ---------- Menu mobile (sobreposto, não empurra a página) ---------- */
  .header__menu-toggle { display: none; background: none; }
  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text);
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-fast);
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -6px; }
  .header__burger::after { content: ''; position: absolute; top: 6px; }
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { transform: translateY(6px) rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { transform: translateY(-6px) rotate(-45deg); }

  .header__mobile-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100svh - var(--header-altura));
    overflow-y: auto;
    padding: 8px 0 24px;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.25);
    animation: header-desce var(--dur-base) var(--ease-out);
  }
  .header__mobile-menu, .header__mobile-submenu { list-style: none; }
  .header__mobile-link { display: block; padding: 14px 0; font-family: var(--font-heading-family); font-size: 1.5rem; color: var(--color-text); border-bottom: 1px solid var(--color-border); }
  .header__mobile-link--child { padding: 10px 0 10px 16px; font-family: var(--font-body-family); font-size: 1rem; opacity: 0.8; border-bottom: 0; }
  .header__localization { padding: 8px 0; }

  @keyframes header-desce { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

  @media screen and (max-width: 1000px) {
    .header__inner { grid-template-columns: 1fr auto 1fr; gap: 8px; min-height: 60px; }
    .header__nav { display: none; }
    .header__menu-toggle { display: inline-flex; justify-self: start; margin-left: -10px; }
    .header__logo-link { justify-self: center; }
    .logo__nome { font-size: 1.05rem; }
    .header__conta { display: none; }
    .header__actions { margin-right: -10px; }
  }
  @media screen and (min-width: 1001px) {
    .header__mobile-nav { display: none !important; }
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;
    var secao = header.closest('.shopify-section') || header;
    var raiz = document.documentElement;

    /* --- Menu mobile --- */
    var toggle = header.querySelector('.header__menu-toggle');
    var nav = document.getElementById('MobileNav-{{ section.id }}');
    if (toggle && nav) {
      toggle.addEventListener('click', function () {
        var aberto = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!aberto));
        nav.hidden = aberto;
      });
    }

    /* --- Alturas em CSS vars (hero = 100svh - topo) --- */
    function medir() {
      var barra = document.querySelector('.section-barra-anuncio');
      var alturaHeader = header.offsetHeight;
      var alturaBarra = barra ? barra.offsetHeight : 0;
      raiz.style.setProperty('--header-altura', alturaHeader + 'px');
      raiz.style.setProperty('--topo-altura', alturaHeader + alturaBarra + 'px');
    }
    medir();
    if ('ResizeObserver' in window) new ResizeObserver(medir).observe(header);
    window.addEventListener('resize', medir, { passive: true });

    /* --- Estado "rolado" (sombra) --- */
    var rolado = false;
    function aoRolar() {
      var agora = window.scrollY > 8;
      if (agora === rolado) return;
      rolado = agora;
      secao.classList.toggle('is-rolado', agora);
    }
    aoRolar();
    window.addEventListener('scroll', aoRolar, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "text",
      "id": "nome_logo",
      "label": "Nome na logo",
      "default": "Orvalho",
      "info": "Usado quando não há logo em imagem (Configurações do tema → Logo)."
    },
    {
      "type": "text",
      "id": "termos_populares",
      "label": "Buscas populares",
      "default": "Anel, Brinco, Colar",
      "info": "Sugestões mostradas no popup de busca, separadas por vírgula."
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__localization.content"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.header.settings.enable_country_selector.label"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.header.settings.enable_language_selector.label"
    }
  ]
}
{% endschema %}
