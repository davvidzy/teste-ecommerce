{%- comment -%}
  ============================================================
  MAIN LIST COLLECTIONS — página /collections ("Todas as coleções")
  ============================================================

  O QUE FAZ:
  Lista as coleções da loja com o mesmo card da seção Categorias
  (snippets/card-colecao.liquid): foto, nome e número de peças.

  QUAIS COLEÇÕES APARECEM:
  - "Todas" (padrão): todas as coleções publicadas, em ordem
    alfabética (é o que o objeto collections do Shopify devolve),
    menos a "frontpage" (coleção técnica "Home page" do Shopify).
  - "Escolhidas": só as marcadas no editor, na ordem escolhida —
    útil para esconder coleções técnicas (ex.: "Página inicial").
  Coleções sem produtos continuam aparecendo com "Em breve" se você
  quiser anunciar algo antes de cadastrar as peças; para esconder,
  use o modo "Escolhidas" ou despublique a coleção no admin.

  SETTINGS: título, texto, modo, coleções escolhidas, colunas.
{%- endcomment -%}

<div class="lista-colecoes secao page-width" style="--colunas: {{ section.settings.colunas }};">
  <div class="secao-topo secao-topo--centro" data-reveal>
    <div>
      {%- if section.settings.heading != blank -%}
        <h1 class="secao-titulo">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.texto != blank -%}
        <div class="secao-descricao rte">{{ section.settings.texto }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.modo == 'escolhidas' and section.settings.colecoes != blank -%}
    <ul class="lista-colecoes__grade" role="list">
      {%- for colecao in section.settings.colecoes -%}
        <li data-reveal style="--reveal-index: {{ forloop.index0 | modulo: section.settings.colunas }};">
          {% render 'card-colecao', colecao: colecao, indice: forloop.index0, tamanhos: '(min-width: 1000px) 33vw, 50vw' %}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    {%- paginate collections by 12 -%}
      {%- if collections.size == 0 -%}
        <p class="lista-colecoes__vazio">{{ 'sections.categorias.empty' | t }}</p>
      {%- else -%}
        <ul class="lista-colecoes__grade" role="list">
          {%- for colecao in collections -%}
            {%- comment -%} "frontpage" é a coleção técnica que o Shopify cria sozinho ("Home page"): não é vitrine {%- endcomment -%}
            {%- if colecao.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
            <li data-reveal style="--reveal-index: {{ forloop.index0 | modulo: section.settings.colunas }};">
              {% render 'card-colecao', colecao: colecao, indice: forloop.index0, tamanhos: '(min-width: 1000px) 33vw, 50vw' %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{{ 'card-colecao.css' | asset_url | stylesheet_tag }}

<style>
  .lista-colecoes__grade {
    display: grid;
    grid-template-columns: repeat(var(--colunas), minmax(0, 1fr));
    gap: 44px clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lista-colecoes__vazio { padding: 48px 0; text-align: center; opacity: 0.7; }
  .lista-colecoes .pagination { margin-top: 48px; }

  @media screen and (max-width: 1000px) {
    .lista-colecoes__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; }
    .lista-colecoes .card-colecao__legenda { flex-direction: column; gap: 4px; padding-top: 12px; }
  }
</style>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "default": "Coleções", "label": "t:sections.main_list_collections.settings.heading.label" },
    { "type": "richtext", "id": "texto", "label": "Texto" },
    {
      "type": "select",
      "id": "modo",
      "label": "Quais coleções mostrar",
      "options": [
        { "value": "todas", "label": "Todas as publicadas" },
        { "value": "escolhidas", "label": "Só as escolhidas abaixo" }
      ],
      "default": "todas"
    },
    { "type": "collection_list", "id": "colecoes", "label": "Coleções escolhidas", "limit": 24 },
    { "type": "range", "id": "colunas", "label": "Colunas no desktop", "min": 2, "max": 4, "step": 1, "default": 3 }
  ]
}
{% endschema %}
