{%- comment -%}
  ============================================================
  HERO — abertura da home (estática, centralizada, alto contraste)
  ============================================================

  O QUE FAZ:
  Primeira dobra da home: foto em tela cheia (100svh − barra − header),
  título, texto curto e dois botões CENTRALIZADOS, e uma faixa de
  selos de confiança na base.

  DECISÕES (feedback de uso real):
  - SEM animação de entrada nem parallax: o título palavra a palavra
    e o zoom lento atrasavam a leitura da primeira dobra e pareciam
    lentos. A página aparece pronta.
  - CONTRASTE: a foto é clara e o anel fica no centro, exatamente onde
    o texto centralizado cai. Em vez de "véus" parciais, a imagem é
    escurecida por igual (setting "Escurecer imagem") e o texto é
    claro. Funciona igual no desktop e no celular.
  - Selos de confiança sobre uma faixa translúcida escura com blur,
    para continuarem legíveis sobre qualquer parte da foto.
  - Botões: primário sólido CLARO (sobre foto escura o verde some) e
    secundário em contorno claro — mesma hierarquia do resto do site.

  ONDE É USADA:
  templates/index.json → seção "hero".

  PRINCIPAIS PARTES:
  - Settings: imagem, imagem de exemplo, altura, alinhamento,
    escurecer imagem, texto claro/escuro.
  - Blocks: sobrelinha (opcional), titulo, texto, botoes, selo (até 4).
  - O <h1> da home fica aqui.

  OBSERVAÇÕES:
  A imagem usa loading eager + fetchpriority high: é o maior elemento
  da primeira dobra (LCP), então deve carregar primeiro.
{%- endcomment -%}
{%- liquid
  assign classe_texto = 'hero--texto-escuro'
  if section.settings.texto_claro
    assign classe_texto = 'hero--texto-claro'
  endif
  assign overlay = section.settings.sobreposicao | divided_by: 100.0
-%}
<div
  class="hero hero--{{ section.settings.altura }} hero--{{ section.settings.alinhamento }} {{ classe_texto }}"
  style="--overlay: {{ overlay }};"
  data-section-id="{{ section.id }}"
>
  <div class="hero__media">
    {%- if section.settings.imagem != blank -%}
      {{
        section.settings.imagem
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__imagem',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          alt: section.settings.imagem.alt | escape
      }}
    {%- elsif section.settings.imagem_exemplo -%}
      {%- comment -%}
        Imagem de exemplo que vem junto com o tema (assets/hero-orvalho-*.jpg,
        banco de imagens Magnific/Freepik). Assets não passam pelo image_url,
        então o srcset é montado à mão com 3 tamanhos gerados previamente.
      {%- endcomment -%}
      <img
        class="hero__imagem"
        src="{{ 'hero-orvalho-1500.jpg' | asset_url }}"
        srcset="{{ 'hero-orvalho-900.jpg' | asset_url }} 900w, {{ 'hero-orvalho-1500.jpg' | asset_url }} 1500w, {{ 'hero-orvalho-2400.jpg' | asset_url }} 2400w"
        sizes="100vw"
        width="2400"
        height="1558"
        alt="{{ 'sections.hero.image_alt' | t }}"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero__fundo-liso" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="hero__conteudo page-width">
    <div class="hero__caixa">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'sobrelinha' -%}
            {%- if block.settings.texto != blank -%}
              <p class="hero__sobrelinha" {{ block.shopify_attributes }}>{{ block.settings.texto | escape }}</p>
            {%- endif -%}

          {%- when 'titulo' -%}
            <h1 class="hero__titulo" {{ block.shopify_attributes }}>{{ block.settings.titulo | escape }}</h1>

          {%- when 'texto' -%}
            <div class="hero__texto rte" {{ block.shopify_attributes }}>{{ block.settings.texto }}</div>

          {%- when 'botoes' -%}
            <div class="hero__botoes" {{ block.shopify_attributes }}>
              {%- if block.settings.rotulo_1 != blank -%}
                <a href="{{ block.settings.link_1 | default: routes.all_products_collection_url }}" class="button button--grande hero__botao hero__botao--primario">
                  <span>{{ block.settings.rotulo_1 | escape }}</span>
                  {% render 'icon', name: 'seta' %}
                </a>
              {%- endif -%}
              {%- if block.settings.rotulo_2 != blank -%}
                <a href="{{ block.settings.link_2 | default: routes.collections_url }}" class="button button--secondary button--grande hero__botao hero__botao--contorno">
                  {{ block.settings.rotulo_2 | escape }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- assign selos = section.blocks | where: 'type', 'selo' -%}
  {%- if selos.size > 0 -%}
    <div class="hero__faixa">
      <ul class="hero__selos page-width" role="list">
        {%- for block in selos -%}
          <li class="hero__selo" {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icone %}
            <span>{{ block.settings.texto | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--hero-texto);
    background: var(--color-accent);
  }
  /* "Tela cheia" = altura visível MENOS barra de anúncio + header (medidas pelo JS do header) */
  .hero--tela { min-height: calc(100svh - var(--topo-altura, 108px)); }
  .hero--grande { min-height: 75svh; }
  .hero--media { min-height: 60svh; }
  .hero--texto-claro { --hero-texto: #ffffff; }
  .hero--texto-escuro { --hero-texto: var(--color-text); }

  /* ---------- Mídia ---------- */
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__imagem { width: 100%; height: 100%; object-fit: cover; }
  .hero__fundo-liso { width: 100%; height: 100%; background: var(--color-accent); }

  /* Escurecimento UNIFORME (texto claro) — contraste previsível em qualquer ponto da foto */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero--texto-claro::before { background: rgb(18 22 20 / var(--overlay)); }
  .hero--texto-escuro::before { background: color-mix(in srgb, var(--color-background) calc(var(--overlay) * 100%), transparent); }

  /* ---------- Conteúdo ---------- */
  .hero__conteudo {
    flex: 1;
    display: flex;
    align-items: center;
    padding-top: clamp(48px, 8vh, 96px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .hero__caixa { width: 100%; max-width: 780px; }
  .hero--centro .hero__conteudo { justify-content: center; text-align: center; }
  .hero--centro .hero__caixa { margin: 0 auto; }
  .hero--centro .hero__texto { margin-left: auto; margin-right: auto; }
  .hero--centro .hero__botoes { justify-content: center; }

  .hero__sobrelinha { font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; margin-bottom: 18px; }
  .hero__titulo {
    font-size: clamp(2.5rem, 5.4vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 22px;
    text-wrap: balance; /* quebra as linhas de forma equilibrada */
  }
  .hero--texto-claro .hero__titulo,
  .hero--texto-claro .hero__texto { text-shadow: 0 1px 24px rgb(0 0 0 / 0.25); }
  .hero__texto { font-size: 1.125rem; line-height: 1.6; max-width: 540px; margin-bottom: 32px; text-wrap: pretty; }
  .hero__texto a { color: inherit; text-decoration: underline; }

  /* ---------- Botões (sistema global; aqui só a versão "sobre foto escura") ---------- */
  .hero__botoes { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero--texto-claro .hero__botao--primario {
    --btn-fundo: #ffffff;
    --btn-texto: var(--color-text);
    --btn-borda: #ffffff;
  }
  .hero--texto-claro .button.hero__botao--primario:hover {
    --btn-fundo: var(--color-accent);
    --btn-texto: var(--color-accent-text);
    --btn-borda: var(--color-accent);
  }
  .hero--texto-claro .hero__botao--contorno {
    --btn-texto: #ffffff;
    --btn-borda: rgb(255 255 255 / 0.75);
  }
  .hero--texto-claro .button.hero__botao--contorno:hover {
    --btn-fundo: #ffffff;
    --btn-texto: var(--color-text);
    --btn-borda: #ffffff;
  }

  /* ---------- Faixa de selos (translúcida + blur = legível sobre qualquer foto) ---------- */
  .hero__faixa {
    background: rgb(18 22 20 / 0.35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .hero--texto-escuro .hero__faixa { background: color-mix(in srgb, var(--color-background) 80%, transparent); border-top-color: var(--color-border); }
  .hero__selos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 44px;
    padding-top: 16px;
    padding-bottom: 16px;
    list-style: none;
  }
  .hero__selo { display: flex; align-items: center; gap: 10px; font-size: 0.875rem; font-weight: 500; }
  .hero__selo svg { flex-shrink: 0; width: 20px; height: 20px; }

  @media screen and (max-width: 1000px) {
    /* Título maior no celular = hierarquia clara (título ≫ texto ≫ botões). O texto do
       título foi pensado para caber em 2 linhas até em telas de 320px. */
    .hero__titulo { font-size: clamp(2.5rem, 11vw, 3.25rem); margin-bottom: 20px; }
    .hero__texto { font-size: 1rem; margin-bottom: 36px; }
    .hero__botoes { flex-direction: column; align-items: stretch; gap: 12px; }
    .hero__selos { flex-direction: column; align-items: center; gap: 10px; padding-top: 18px; padding-bottom: 18px; }
    .hero__selo { font-size: 0.8125rem; }
    /* No celular o texto ocupa mais área da foto: escurece um pouco mais */
    .hero--texto-claro::before { background: rgb(18 22 20 / calc(var(--overlay) + 0.1)); }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "imagem", "label": "Imagem de fundo", "info": "Recomendado: 2400 × 1400 px." },
    { "type": "checkbox", "id": "imagem_exemplo", "label": "Sem imagem escolhida: usar a foto de exemplo do tema", "default": true },
    {
      "type": "select",
      "id": "altura",
      "label": "Altura",
      "options": [
        { "value": "tela", "label": "Tela cheia" },
        { "value": "grande", "label": "Grande" },
        { "value": "media", "label": "Média" }
      ],
      "default": "tela"
    },
    {
      "type": "select",
      "id": "alinhamento",
      "label": "Alinhamento do conteúdo",
      "options": [
        { "value": "esquerda", "label": "Esquerda" },
        { "value": "centro", "label": "Centro" }
      ],
      "default": "centro"
    },
    { "type": "range", "id": "sobreposicao", "label": "Escurecer imagem", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45, "info": "Com texto claro, 40–55% garante leitura em fotos claras." },
    { "type": "checkbox", "id": "texto_claro", "label": "Texto claro (sobre imagem escurecida)", "default": true }
  ],
  "blocks": [
    {
      "type": "sobrelinha",
      "name": "Sobrelinha",
      "limit": 1,
      "settings": [{ "type": "text", "id": "texto", "label": "Texto" }]
    },
    {
      "type": "titulo",
      "name": "Título",
      "limit": 1,
      "settings": [{ "type": "text", "id": "titulo", "label": "Título", "default": "Joias que nascem da natureza" }]
    },
    {
      "type": "texto",
      "name": "Texto",
      "limit": 1,
      "settings": [{ "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Diamantes cultivados em laboratório, ouro reciclado e design inspirado no que cresce.</p>" }]
    },
    {
      "type": "botoes",
      "name": "Botões",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "rotulo_1", "label": "Botão principal — texto", "default": "Ver catálogo" },
        { "type": "url", "id": "link_1", "label": "Botão principal — link" },
        { "type": "text", "id": "rotulo_2", "label": "Botão secundário — texto", "default": "Nossas coleções" },
        { "type": "url", "id": "link_2", "label": "Botão secundário — link" }
      ]
    },
    {
      "type": "selo",
      "name": "Selo de confiança",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Ícone",
          "options": [
            { "value": "entrega", "label": "Entrega" },
            { "value": "escudo", "label": "Garantia" },
            { "value": "folha", "label": "Sustentável" },
            { "value": "presente", "label": "Presente" },
            { "value": "diamante", "label": "Diamante" }
          ],
          "default": "entrega"
        },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Frete grátis para todo o Brasil" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "titulo" },
        { "type": "texto" },
        { "type": "botoes" },
        { "type": "selo", "settings": { "icone": "entrega", "texto": "Frete grátis para todo o Brasil" } },
        { "type": "selo", "settings": { "icone": "escudo", "texto": "Garantia vitalícia" } },
        { "type": "selo", "settings": { "icone": "folha", "texto": "Uma árvore plantada por pedido" } }
      ]
    }
  ]
}
{% endschema %}
