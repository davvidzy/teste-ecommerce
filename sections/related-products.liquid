{%- comment -%}
  ============================================================
  RELATED PRODUCTS — produtos relacionados (recomendações)
  ============================================================

  O QUE FAZ:
  Exibe produtos relacionados usando a API de recomendações do Shopify.
  Um web component (<product-recommendations>) busca via fetch os
  produtos sugeridos e injeta o grid no DOM (lazy, sem lib externa).

  ONDE É USADA:
  Template product (abaixo da página do produto).

  PRINCIPAIS PARTES:
  - data-url monta a requisição com section_id, product_id e limit
  - customElements 'product-recommendations': faz o fetch e injeta o HTML
  - render 'card-catalogo': o MESMO card da home (galeria com setas,
    badges e compra rápida). A grade fica dentro de <catalogo-abas>
    (assets/catalogo.js) só para reaproveitar o comportamento das
    setas, swatches e do botão de compra — não há abas aqui.
  - Settings: enable, heading, products_to_show

  OBSERVAÇÕES:
  Só renderiza se enable estiver marcado. O grid só aparece quando
  recommendations.performed e há produtos retornados.
{%- endcomment -%}
{%- if section.settings.enable -%}
  {{ 'card-catalogo.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'catalogo.js' | asset_url }}" defer="defer"></script>

  <product-recommendations
    class="related-products page-width"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <h2 class="related-products__title">{{ section.settings.heading | escape }}</h2>
      <catalogo-abas class="related-products__grade-wrapper">
        <ul class="related-products__grade" role="list" style="--colunas: {{ section.settings.products_to_show | at_most: 4 }};">
          {%- for product in recommendations.products -%}
            <li>{% render 'card-catalogo', produto: product, secao: section %}</li>
          {%- endfor -%}
        </ul>
      </catalogo-abas>
    {%- endif -%}
  </product-recommendations>

  <style>
    .related-products { display: block; padding-top: var(--espaco-secao); padding-bottom: var(--espaco-secao); border-top: 1px solid var(--color-border); }
    .related-products__title { font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 32px; }
    .related-products__grade-wrapper { display: block; }
    .related-products__grade {
      display: grid;
      grid-template-columns: repeat(var(--colunas), minmax(0, 1fr));
      gap: 44px clamp(16px, 2vw, 28px);
      list-style: none;
    }
    @media screen and (max-width: 1000px) {
      .related-products__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; }
    }
  </style>

  <script>
    if (!customElements.get('product-recommendations')) {
      customElements.define('product-recommendations', class extends HTMLElement {
        connectedCallback() {
          var el = this;
          if (el.querySelector('.related-products__grade')) return;
          fetch(el.dataset.url)
            .then(function (r) { return r.text(); })
            .then(function (text) {
              var html = document.createElement('div');
              html.innerHTML = text;
              var recos = html.querySelector('product-recommendations');
              if (recos && recos.innerHTML.trim().length) { el.innerHTML = recos.innerHTML; }
            })
            .catch(function (e) { console.error(e); });
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "default": true,
      "label": "t:sections.related_products.settings.enable.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "You may also like",
      "label": "t:sections.related_products.settings.heading.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.related_products.settings.products_to_show.label"
    }
  ]
}
{% endschema %}
