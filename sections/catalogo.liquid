{%- comment -%}
  ============================================================
  CATÁLOGO — vitrine com abas, swatches e compra rápida
  ============================================================

  O QUE FAZ:
  Mostra produtos de várias coleções, uma por aba ("Mais desejadas",
  "Anéis", "Brincos"...). Trocar de aba é instantâneo: todos os
  painéis já vêm renderizados no HTML e o JS só mostra/esconde,
  com animação de saída, cascata de entrada e um indicador que
  desliza até a aba ativa.

  ONDE É USADA:
  templates/index.json → seção "catalogo". Tem preset.

  PRINCIPAIS PARTES:
  - <catalogo-abas>: custom element (Web Component) definido em
    assets/catalogo.js. Ele cuida de abas, teclado, swatches e do
    estado do botão de compra rápida.
  - Blocks "aba": cada um escolhe uma coleção (vazia = todos os
    produtos) e um rótulo opcional. Até 6 abas.
  - snippets/catalogo-painel: grade + "Ver todos" de cada aba.
  - snippets/card-catalogo: o card (swatches, badges, compra rápida).

  ACESSIBILIDADE (padrão WAI-ARIA "Tabs"):
  - role="tablist" / "tab" / "tabpanel" + aria-selected/controls.
  - Setas ← → , Home e End movem entre abas; só a aba ativa entra
    no Tab (tabindex 0), as outras ficam com tabindex -1.
  - Sem JavaScript: as abas somem e todos os painéis aparecem um
    embaixo do outro (nada fica inacessível).

  POR QUE TODOS OS PAINÉIS NO HTML (e não buscar por AJAX)?
  Para até ~6 abas × 8 produtos o HTML extra é pequeno, a troca fica
  instantânea e não depende de rede. Para catálogos maiores, o
  caminho seria a Section Rendering API (ver docs/LOJA-ORVALHO.md).
{%- endcomment -%}
{%- liquid
  assign tem_abas = false
  if section.blocks.size > 1
    assign tem_abas = true
  endif
-%}
<catalogo-abas
  class="catalogo page-width"
  id="Catalogo-{{ section.id }}"
  style="--colunas: {{ section.settings.colunas }}; --colunas-mobile: {{ section.settings.colunas_mobile }};"
  data-section-id="{{ section.id }}"
>
  <div class="catalogo__topo">
    <div class="catalogo__cabecalho">
      {%- if section.settings.sobrelinha != blank -%}
        <p class="catalogo__sobrelinha" data-reveal>{{ section.settings.sobrelinha | escape }}</p>
      {%- endif -%}
      {%- if section.settings.titulo != blank -%}
        <h2 class="catalogo__titulo" data-reveal style="--reveal-index: 1;">{{ section.settings.titulo | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if tem_abas -%}
      <div class="catalogo__abas" role="tablist" aria-label="{{ section.settings.titulo | default: 'Catálogo' | escape }}" data-reveal="fade" style="--reveal-index: 2;">
        {%- for block in section.blocks -%}
          {%- liquid
            assign colecao = block.settings.colecao | default: collections.all
            assign rotulo = block.settings.rotulo
            if rotulo == blank
              if block.settings.colecao == blank
                assign rotulo = 'sections.catalogo.all' | t
              else
                assign rotulo = colecao.title
              endif
            endif
          -%}
          <button
            type="button"
            role="tab"
            class="catalogo__aba"
            id="Aba-{{ block.id }}"
            aria-controls="Painel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ rotulo | escape }}
          </button>
        {%- endfor -%}
        <span class="catalogo__indicador" aria-hidden="true" data-indicador></span>
      </div>
    {%- endif -%}
  </div>

  <div class="catalogo__paineis" data-paineis>
    {%- if section.blocks.size == 0 -%}
      {% render 'catalogo-painel', colecao: collections.all, id_painel: 'Painel-unico', id_aba: nil, ativo: true, secao: section %}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign colecao = block.settings.colecao | default: collections.all
          assign id_aba = nil
          if tem_abas
            assign id_aba = 'Aba-' | append: block.id
          endif
          assign id_painel = 'Painel-' | append: block.id
        -%}
        {% render 'catalogo-painel', colecao: colecao, id_painel: id_painel, id_aba: id_aba, ativo: forloop.first, secao: section %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</catalogo-abas>

<script src="{{ 'catalogo.js' | asset_url }}" defer="defer"></script>

<style>
  .catalogo { display: block; padding-top: calc(var(--spacing-sections) * 2); padding-bottom: calc(var(--spacing-sections) * 2); }

  /* ---------- Topo: título + abas ---------- */
  .catalogo__topo { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 24px 48px; margin-bottom: 40px; }
  .catalogo__sobrelinha { font-size: var(--f1); letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.65; margin-bottom: 12px; }
  .catalogo__titulo { font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.08; letter-spacing: -0.015em; }

  .catalogo__abas {
    position: relative;
    display: flex;
    gap: 28px;
    max-width: 100%;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-border);
  }
  .catalogo__aba {
    min-height: 44px;
    padding: 10px 0;
    background: none;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: var(--f2);
    white-space: nowrap;
    opacity: 0.5;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .catalogo__aba:hover,
  .catalogo__aba[aria-selected='true'] { opacity: 1; }
  .catalogo__indicador {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;          /* largura real = scaleX(--w): animar transform é mais leve que animar width */
    height: 2px;
    background: currentColor;
    transform-origin: 0 0;
    transform: translateX(var(--x, 0px)) scaleX(var(--w, 0));
    transition: transform 550ms var(--ease-out);
  }
  .no-js .catalogo__abas { display: none; }

  /* ---------- Painéis ---------- */
  .catalogo__paineis { position: relative; transition: height var(--dur-base) var(--ease-out); }
  .catalogo__painel { transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease; }
  .catalogo__painel:focus-visible { outline-offset: 8px; }
  .catalogo__painel.is-saindo { opacity: 0; transform: translate3d(0, -8px, 0); }
  .no-js .catalogo__painel[hidden] { display: block; opacity: 1; visibility: visible; margin-top: 56px; }

  .catalogo__grade {
    display: grid;
    grid-template-columns: repeat(var(--colunas), minmax(0, 1fr));
    gap: 48px 24px;
    list-style: none;
  }
  .catalogo__rodape { display: flex; justify-content: center; margin-top: 56px; }
  .catalogo__ver-todos { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: inherit; font-size: var(--f2); }
  .catalogo__ver-todos svg { transition: transform var(--dur-base) var(--ease-out); }
  .catalogo__ver-todos:hover svg { transform: translateX(4px); }

  /* ---------- Card ---------- */
  .card-cat { position: relative; }
  .card-cat__media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--media-radius);
    /* --card-tint muda ao escolher um swatch: o fundo "pega" a cor do metal */
    background-color: color-mix(in srgb, var(--card-tint) 30%, var(--color-background-contrast));
    transition: background-color var(--dur-slow) var(--ease-out);
  }
  .card-cat__link-media { position: absolute; inset: 0; display: block; }
  .card-cat__imagem {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 600ms var(--ease-out), transform 1200ms var(--ease-out);
  }
  .card-cat__imagem--secundaria { opacity: 0; }
  .card-cat.is-trocando .card-cat__imagem--principal { opacity: 0.3; }
  .card-cat .placeholder-svg { fill: color-mix(in srgb, var(--color-text) 22%, transparent); background: transparent; }

  @media (hover: hover) {
    .card-cat:hover .card-cat__imagem--principal { transform: scale(1.045); }
    .card-cat:hover .card-cat__imagem--secundaria { opacity: 1; transform: scale(1.045); }
    .card-cat.swatch-escolhido:hover .card-cat__imagem--secundaria { opacity: 0; }
  }

  /* Badges */
  .card-cat__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-wrap: wrap; gap: 6px; pointer-events: none; }
  .card-cat__badge {
    padding: 5px 10px;
    font-size: var(--f0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    color: var(--color-text);
    background: var(--color-background);
  }
  .card-cat__badge--desconto { color: var(--color-accent-text); background: var(--color-accent); }
  .card-cat__badge[hidden] { display: none; }

  /* Compra rápida — no desktop desliza de baixo no hover */
  .card-cat__form,
  .card-cat__botao--opcoes { position: absolute; left: 12px; right: 12px; bottom: 12px; }
  .card-cat__botao {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 46px;
    padding: 0 16px;
    font-family: var(--font-body-family);
    font-size: var(--f1);
    color: var(--color-text);
    background: var(--color-background);
    border-radius: var(--buttons-radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
    opacity: 0;
    transform: translate3d(0, calc(100% + 16px), 0);
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .card-cat:hover .card-cat__botao,
  .card-cat:focus-within .card-cat__botao,
  .card-cat__botao[data-estado='carregando'],
  .card-cat__botao[data-estado='sucesso'] { opacity: 1; transform: none; }
  .card-cat__botao:hover:not(:disabled),
  .card-cat__botao[data-estado='sucesso'] { color: var(--color-accent-text); background: var(--color-accent); }
  .card-cat__botao:disabled { cursor: not-allowed !important; color: color-mix(in srgb, var(--color-text) 55%, transparent); }

  /* Os 4 estados ficam empilhados na mesma célula do grid; só o ativo aparece */
  .card-cat__estado {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition: opacity var(--dur-fast) ease, transform var(--dur-base) var(--ease-out);
  }
  .card-cat__botao[data-estado='padrao'] .card-cat__estado--padrao,
  .card-cat__botao[data-estado='carregando'] .card-cat__estado--carregando,
  .card-cat__botao[data-estado='sucesso'] .card-cat__estado--sucesso,
  .card-cat__botao[data-estado='esgotado'] .card-cat__estado--esgotado { opacity: 1; transform: none; }
  .card-cat__spinner {
    width: 16px;
    height: 16px;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: catalogo-gira 700ms linear infinite;
  }

  /* No toque não existe hover: vira um botão redondo sempre visível */
  @media (hover: none) {
    .card-cat__form,
    .card-cat__botao--opcoes { left: auto; right: 10px; bottom: 10px; }
    .card-cat__botao { width: 44px; min-height: 44px; height: 44px; padding: 0; border-radius: 50%; opacity: 1; transform: none; }
    .card-cat__rotulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .card-cat__botao[data-estado='esgotado'] { display: none; }
  }

  /* Informações */
  .card-cat__info { display: grid; gap: 6px; padding-top: 16px; }
  .card-cat__swatches { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .card-cat__swatch {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--swatch-cor);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .card-cat__swatch::before { content: ''; position: absolute; inset: -9px; } /* área de toque maior que o círculo */
  .card-cat__swatch::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--dur-fast) ease, transform var(--dur-base) var(--ease-spring);
  }
  .card-cat__swatch:hover { transform: scale(1.12); }
  .card-cat__swatch[aria-pressed='true']::after { opacity: 1; transform: scale(1); }
  .card-cat__swatch-mais { font-size: var(--f0); color: inherit; opacity: 0.7; }

  .card-cat__titulo { font-family: var(--font-body-family); font-size: var(--f2); line-height: 1.35; }
  .card-cat__titulo-link { color: inherit; }
  .card-cat__titulo-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .card-cat__ficha { font-size: var(--f1); opacity: 0.62; }
  .card-cat__preco { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 8px; font-size: var(--f2); }
  .card-cat__preco-de { font-size: var(--f1); opacity: 0.5; }
  .card-cat__preco-de[hidden] { display: none; }

  @keyframes catalogo-gira { to { transform: rotate(360deg); } }

  @media screen and (max-width: 1000px) {
    .catalogo__topo { margin-bottom: 28px; }
    .catalogo__abas { width: 100%; gap: 22px; }
    .catalogo__grade { grid-template-columns: repeat(var(--colunas-mobile), minmax(0, 1fr)); gap: 32px 12px; }
  }
</style>

{% schema %}
{
  "name": "Catálogo com abas",
  "tag": "section",
  "class": "section-catalogo",
  "settings": [
    { "type": "text", "id": "sobrelinha", "label": "Sobrelinha", "default": "Curadoria" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "As mais desejadas" },
    { "type": "range", "id": "produtos_por_aba", "label": "Produtos por aba", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "colunas", "label": "Colunas no desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "colunas_mobile",
      "label": "Colunas no celular",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "header", "content": "Swatches de cor" },
    {
      "type": "text",
      "id": "opcoes_swatch",
      "label": "Opções que viram swatch",
      "default": "metal, cor, color",
      "info": "Nomes das opções de variante (separados por vírgula). A primeira que o produto tiver aparece como bolinhas de cor."
    },
    {
      "type": "textarea",
      "id": "mapa_cores",
      "label": "Mapa de cores",
      "default": "Ouro amarelo: #E3C77A\nOuro branco: #E4E4E0\nOuro rosé: #E8B4A0\nPrata: #C8CBCF",
      "info": "Um por linha, no formato Nome: #hex. Usado quando a opção não tem swatch nativo configurado no admin."
    }
  ],
  "blocks": [
    {
      "type": "aba",
      "name": "Aba",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "colecao", "label": "Coleção", "info": "Vazio = todos os produtos da loja." },
        { "type": "text", "id": "rotulo", "label": "Rótulo da aba", "info": "Vazio = nome da coleção." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catálogo com abas",
      "blocks": [
        { "type": "aba", "settings": { "rotulo": "Todas" } },
        { "type": "aba", "settings": { "rotulo": "Anéis" } },
        { "type": "aba", "settings": { "rotulo": "Brincos" } }
      ]
    }
  ]
}
{% endschema %}
