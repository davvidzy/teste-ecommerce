{%- comment -%}
  ============================================================
  MAIN PRODUCT — página de produto (Shopify OS 2.0)
  ============================================================

  O QUE FAZ:
  Página de produto em duas colunas:
  - ESQUERDA (galeria): cada mídia ocupa a altura útil da tela
    (100svh − header − margens) e a largura toda da coluna, até a
    margem padrão do site (--gutter). As imagens ficam empilhadas;
    no celular viram um carrossel com swipe + pontinhos.
  - DIREITA (informações): fixa (sticky) enquanto a galeria rola,
    com altura mínima de uma tela e conteúdo centralizado
    verticalmente — "100vh de informações".

  ONDE É USADA:
  templates/product.json (seção "main").

  PRINCIPAIS PARTES:
  - {% form 'product' %}: form nativo; o assets/carrinho.js
    intercepta o envio (AJAX + "+" voando até a sacola).
  - Blocks: vendor, title, price, variant_picker, quantity,
    buy_buttons, description (em acordeão), share, custom_liquid, @app.
  - variant_picker: opções com cor (Metal/Cor) viram bolinhas de cor
    (mesmo mapa da seção Catálogo); as demais viram "pílulas".
    O nome do valor escolhido aparece ao lado do nome da opção.
  - JSON das variantes ([data-variant-json]) lido por
    snippets/product-variant-selection.liquid.

  BOTÕES DE PAGAMENTO RÁPIDO (PayPal, Shop Pay…):
  Desligados aqui (setting show_dynamic_checkout = false). Eles
  continuam aparecendo no CHECKOUT do Shopify — a página de produto
  fica com um único botão principal, sem competir com o "Adicionar".
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign nomes_swatch = section.settings.opcoes_swatch | downcase | replace: ', ', ',' | split: ','
  assign linhas_mapa = section.settings.mapa_cores | newline_to_br | split: '<br />'
-%}

<section class="product page-width" data-section-id="{{ section.id }}">
  <div class="product__media-wrapper">
    {%- if product.media.size > 0 -%}
      <div class="product__media-list" id="ProductMedia-{{ section.id }}" data-pdp-trilho>
        {%- for media in product.media -%}
          <div class="product__media-item" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  # A primeira imagem é o LCP da página: carrega já, com prioridade
                  assign carregamento = 'lazy'
                  assign prioridade = 'auto'
                  if forloop.first
                    assign carregamento = 'eager'
                    assign prioridade = 'high'
                  endif
                -%}
                {{
                  media
                  | image_url: width: 2000
                  | image_tag:
                    loading: carregamento,
                    fetchpriority: prioridade,
                    sizes: '(min-width: 1001px) 55vw, 100vw',
                    widths: '450, 750, 1000, 1400, 2000',
                    alt: media.alt | default: product.title | escape
                }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, image_size: '1920x' }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__pontos" aria-hidden="true" data-pdp-pontos>
          {%- for media in product.media -%}
            <span class="product__ponto{% if forloop.first %} is-ativo{% endif %}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="product__media-list">
        <div class="product__media-item product__media-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__info-conteudo">
      {%- form 'product',
        product,
        id: product_form_id,
        class: 'product__form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          {% if current_variant.available == false %}disabled{% endif %}
          class="product-variant-id"
        >

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
              {%- assign ficha = product.metafields.custom.ficha.value -%}
              {%- if ficha != blank -%}
                <p class="product__ficha">{{ ficha | escape }}</p>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true, show_compare: true %}
                {%- if current_variant.unit_price_measurement -%}
                  <div class="product__unit-price">
                    {{ current_variant.unit_price | money }}
                    <span aria-hidden="true">/</span>
                    {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                      {{ current_variant.unit_price_measurement.reference_value }}
                    {%- endif -%}
                    {{ current_variant.unit_price_measurement.reference_unit }}
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption">
                    {%- if cart.taxes_included -%}
                      {{ 'products.product.include_taxes' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <details class="product__acordeao" {{ block.shopify_attributes }} {% if block.settings.aberto %}open{% endif %}>
                  <summary class="product__acordeao-titulo">
                    {{ 'products.product.description' | t }}
                    <span class="product__acordeao-icone" aria-hidden="true"></span>
                  </summary>
                  <div class="product__description rte">{{ product.description }}</div>
                </details>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product__variants" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign nome_opcao = option.name | downcase | strip -%}
                    {%- assign indice_opcao = option.position | minus: 1 -%}
                    {%- assign opcao_de_cor = false -%}
                    {%- if nomes_swatch contains nome_opcao -%}{%- assign opcao_de_cor = true -%}{%- endif -%}
                    <fieldset class="product__option{% if opcao_de_cor %} product__option--cor{% endif %}">
                      <legend class="product__option-name">
                        {{ option.name }}<span aria-hidden="true">:</span>
                        <span class="product__option-valor" data-valor-selecionado>{{ option.selected_value }}</span>
                      </legend>
                      <div class="product__option-valores">
                        {%- for value in option.values -%}
                          {%- liquid
                            # Um valor fica "indisponível" se NENHUMA variante disponível o usa.
                            # (Antes usava forloop.parentloop, que aqui aponta para o laço dos
                            # VALORES e não das opções — por isso a posição explícita.)
                            assign option_disabled = true
                            for variant in product.variants
                              if variant.available and variant.options[indice_opcao] == value
                                assign option_disabled = false
                                break
                              endif
                            endfor

                            assign cor = value.swatch.color
                            if opcao_de_cor and cor == blank
                              assign nome_valor = value.name | downcase | strip
                              for linha in linhas_mapa
                                assign partes = linha | split: ':'
                                assign nome_mapa = partes.first | strip | downcase
                                if nome_mapa == nome_valor
                                  assign cor = partes.last | strip
                                  break
                                endif
                              endfor
                            endif
                          -%}
                          <label class="product__swatch {% if option.selected_value == value %}is-selected{% endif %} {% if option_disabled %}is-unavailable{% endif %}{% if opcao_de_cor %} product__swatch--cor{% endif %}" title="{{ value | escape }}">
                            <input
                              type="radio"
                              name="{{ option.name }}"
                              value="{{ value | escape }}"
                              class="visually-hidden"
                              {% if option.selected_value == value %}checked{% endif %}
                              data-option-index="{{ indice_opcao }}"
                            >
                            {%- if value.swatch.image -%}
                              <span class="product__swatch-media" style="background-image:url({{ value.swatch.image | image_url: width: 100 }})"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            {%- elsif opcao_de_cor and cor != blank -%}
                              <span class="product__swatch-color" style="background-color: {{ cor }};"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              <span class="product__swatch-label">{{ value }}</span>
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>

                <script type="application/json" data-variant-json>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available | json }},
                        "featured_media_id": {{ variant.featured_media.id | json }},
                        "price_html": {%- capture variant_price_html -%}{% render 'price', product: variant, use_variant: false, show_compare: true %}{%- endcapture -%}{{ variant_price_html | strip_newlines | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label class="product__option-name" for="Quantity-{{ section.id }}">
                  {{ 'products.product.quantity.label' | t }}
                </label>
                <div class="quantity-selector">
                  <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">&minus;</button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    min="1"
                    value="1"
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                  >
                  <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">&plus;</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy-buttons" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="button button--grande button--bloco product__add-to-cart"
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  <span>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              </div>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                {% render 'share-button',
                  share_link: product.url,
                  share_title: product.title,
                  share_image: product.featured_image
                %}
              </div>

            {%- when 'informacao' -%}
              {%- liquid
                # Conteúdo: página escolhida (reaproveita o texto da política/página) OU texto do bloco
                assign conteudo = block.settings.conteudo
                if block.settings.pagina != blank
                  assign conteudo = block.settings.pagina.content
                endif
              -%}
              {%- if block.settings.titulo != blank and conteudo != blank -%}
                <details class="product__acordeao" {{ block.shopify_attributes }}>
                  <summary class="product__acordeao-titulo">
                    <span class="product__acordeao-rotulo">
                      {%- if block.settings.icone != 'nenhum' -%}{% render 'icon', name: block.settings.icone %}{%- endif -%}
                      {{ block.settings.titulo | escape }}
                    </span>
                    <span class="product__acordeao-icone" aria-hidden="true"></span>
                  </summary>
                  <div class="product__description rte">{{ conteudo }}</div>
                </details>
              {%- endif -%}

            {%- when 'guia_tamanhos' -%}
              {%- liquid
                # Só aparece em produtos que têm uma opção de tamanho (ex.: anéis com "Aro").
                # Setting vazia = aparece em todos.
                assign opcoes_guia = block.settings.opcoes | downcase | replace: ', ', ',' | split: ','
                assign mostrar_guia = false
                if block.settings.opcoes == blank
                  assign mostrar_guia = true
                else
                  for opcao in product.options
                    assign nome_opcao_guia = opcao | downcase | strip
                    if opcoes_guia contains nome_opcao_guia
                      assign mostrar_guia = true
                      break
                    endif
                  endfor
                endif
                assign id_guia = 'GuiaTamanhos-' | append: block.id
              -%}
              {%- if mostrar_guia -%}
                <div class="product__guia" {{ block.shopify_attributes }}>
                  {%- comment -%} Sem JS, o link leva à página do guia; com JS, abre o pop-up {%- endcomment -%}
                  <a href="{{ block.settings.pagina.url | default: '/pages/guia-de-tamanhos' }}" class="button button--tertiary button--pequeno" data-abrir-guia aria-controls="{{ id_guia }}" aria-haspopup="dialog">
                    {% render 'icon', name: 'regua' %}
                    {{ 'sections.guia.open' | t }}
                  </a>
                </div>
              {%- endif -%}

            {%- when 'beneficios' -%}
              <ul class="product__beneficios" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.texto_1 != blank -%}<li>{% render 'icon', name: 'entrega' %}<span>{{ block.settings.texto_1 | escape }}</span></li>{%- endif -%}
                {%- if block.settings.texto_2 != blank -%}<li>{% render 'icon', name: 'troca' %}<span>{{ block.settings.texto_2 | escape }}</span></li>{%- endif -%}
                {%- if block.settings.texto_3 != blank -%}<li>{% render 'icon', name: 'escudo' %}<span>{{ block.settings.texto_3 | escape }}</span></li>{%- endif -%}
              </ul>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}

      {%- comment -%}
        Pop-up do guia de tamanhos: fica FORA do form de compra — senão os
        campos da calculadora seriam enviados junto com o "Adicionar à sacola".
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'guia_tamanhos' -%}
          <dialog class="guia-dialogo" id="GuiaTamanhos-{{ block.id }}" aria-labelledby="GuiaTamanhosTitulo-{{ block.id }}">
            <div class="guia-dialogo__topo">
              <h2 class="guia-dialogo__titulo" id="GuiaTamanhosTitulo-{{ block.id }}">{{ 'sections.guia.open' | t }}</h2>
              <button type="button" class="guia-dialogo__fechar" data-fechar-guia aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
            </div>
            <div class="guia-dialogo__corpo">
              {% render 'guia-tamanhos', id: block.id, colares: block.settings.colares %}
            </div>
          </dialog>
          {{ 'guia-tamanhos.css' | asset_url | stylesheet_tag }}
          <script src="{{ 'guia-tamanhos.js' | asset_url }}" defer="defer"></script>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% render 'product-media-gallery', section_id: section.id %}
{% render 'product-variant-selection', section_id: section.id, product_form_id: product_form_id %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity", "name": "t:sections.main_product.blocks.quantity.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": false,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "Desligado: PayPal/Shop Pay aparecem só no checkout."
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.blocks.description.name",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "aberto", "label": "Começar aberto", "default": false }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 },
    {
      "type": "informacao",
      "name": "Informação (acordeão)",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Entrega e trocas" },
        {
          "type": "select",
          "id": "icone",
          "label": "Ícone",
          "options": [
            { "value": "nenhum", "label": "Nenhum" },
            { "value": "entrega", "label": "Entrega" },
            { "value": "troca", "label": "Troca" },
            { "value": "escudo", "label": "Garantia" },
            { "value": "folha", "label": "Folha" },
            { "value": "diamante", "label": "Diamante" },
            { "value": "presente", "label": "Presente" }
          ],
          "default": "nenhum"
        },
        { "type": "richtext", "id": "conteudo", "label": "Conteúdo", "default": "<p>Frete grátis e seguro para todo o Brasil. Primeira troca de tamanho grátis em até 30 dias.</p>" },
        { "type": "page", "id": "pagina", "label": "Ou: usar o texto de uma página", "info": "Se escolher uma página, o texto dela substitui o conteúdo acima (ex.: página \"Trocas e devoluções\")." }
      ]
    },
    {
      "type": "guia_tamanhos",
      "name": "Guia de tamanhos",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "opcoes", "label": "Mostrar em produtos com a opção", "default": "aro, tamanho, size", "info": "Nomes de opção separados por vírgula. Vazio = mostra em todos os produtos." },
        { "type": "page", "id": "pagina", "label": "Página do guia (sem JavaScript)", "info": "Padrão: /pages/guia-de-tamanhos" },
        { "type": "checkbox", "id": "colares", "label": "Incluir comprimentos de colar", "default": false }
      ]
    },
    {
      "type": "beneficios",
      "name": "Benefícios",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "texto_1", "label": "Entrega", "default": "Frete grátis e seguro" },
        { "type": "text", "id": "texto_2", "label": "Troca", "default": "30 dias para trocar" },
        { "type": "text", "id": "texto_3", "label": "Garantia", "default": "Garantia vitalícia" }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.main_product.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.main_product.blocks.custom_liquid.settings.custom_liquid.label"
        }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Swatches de cor" },
    {
      "type": "text",
      "id": "opcoes_swatch",
      "label": "Opções que viram bolinhas de cor",
      "default": "metal, cor, color"
    },
    {
      "type": "textarea",
      "id": "mapa_cores",
      "label": "Mapa de cores",
      "default": "Ouro amarelo: #E3C77A\nOuro branco: #E4E4E0\nOuro rosé: #E8B4A0\nPrata: #C8CBCF",
      "info": "Um por linha: Nome: #hex. Use os mesmos valores da seção Catálogo."
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_product.name",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity" },
        { "type": "buy_buttons" },
        { "type": "description" },
        { "type": "share" }
      ]
    }
  ]
}
{% endschema %}
